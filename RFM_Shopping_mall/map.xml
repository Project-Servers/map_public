<?xml version="1.0" encoding="utf-8" standalone="no"?><map>
 <!-- マップ名 ※必須※ -->
 <name>RFMショッピングモール</name>
 <!-- マップバージョン ※必須※ -->
 <version>1.2.1</version>
<!-- 製作者  ※必須※　複数人指定可能 -->
 <authors>
            <author uuid = "495d648c-d580-4251-9317-543274595c05"/>
         <author uuid = "1ea382a9-7ba3-4ab6-85ee-5df5f7c6af18"/>
 </authors>
<!-- サブタイトルを設定します -->
<subtitle>静かなショッピングモールで逃走中！</subtitle>
<!-- ゲーム開始時/途中参加時に配られる
アイテムの個数 半角数字で設定 未設定の場合5個に設定されます-->
 <start>
      <egg>12</egg>
      <bone>12</bone>
      <feather>12</feather>
 </start>
 
 <!-- 復活時に配られるアイテムの個数 
 半角数字で設定 未設定の場合5個に設定されます-->
 <rejail>
     <egg>8</egg>
      <bone>8</bone>
     <feather>8</feather>
 </rejail>
 
   <!-- 各種地点 ※必須※-->
 <location>
      <player>134.46,22.0,-135.09,-0.2,-1.04</player>
      <clear>179.54,32.0,-93.1,90.66,10.28</clear>
      <hunter>134.43,24.0,-119.3,179.75,-2.76</hunter>
      <jail>172.49,32.0,-103.79,179.36,2.5</jail>
      <rejail1>68.38,22.0,-151.46,268.6,-0.62</rejail1>
      <rejail2>190.38,30.0,-122.83,90.83,1.07</rejail2>
      <door>134.52,24.0,-119.44,179.36,-0.4</door>
      <opg>134.46,22.0,-135.09,-0.2,-1.04</opg>
<!-- shopは設定しなくても可-->
   <shop>164.3,30.0,-100.44,90.82,2.86</shop>

 </location>

<!-- NPCの出現位置を設定します。
※注意:1※一点に集中して設定せず位置をある程度バラしてください。
     復活地点や初期スポーンなどからも一定の距離をあけてください。
※注意:2※プレイヤーが触れられる位置を設定してください。NPCですので空中などには設定しないでください。
※注意:3※最低5地点を設定してください。(ver10.9.0時点)
     今後のアップデートにて必要最低地点数は変更される場合がありますが、現時点では未定です。多い分には問題ありません。 -->
<npcs>
    <npc loc="134.70,30.00,-173.40"/>
    <npc loc="89.69,30.00,-176.64"/>
    <npc loc="65.70,30.00,-112.70"/>
    <npc loc="200.30,30.00,-110.48"/>
    <npc loc="102.28,22.00,-80.70"/>
    <npc loc="39.86,22.00,-100.15"/>
    <npc loc="57.79,22.00,-214.95"/>
    <npc loc="189.58,22.00,-201.05"/>
    <npc loc="199.45,22.00,-140.34"/>
    <npc loc="76.51,30.00,-162.30"/>
</npcs>

<!-- ゲーム自動終了  true/falseでの記述 -->
 <auto_end>true</auto_end>
<!-- 自動復活の初期値  true/falseでの記述 -->
 <auto_rejail>false</auto_rejail>
<!-- 観戦機能の初期値  true/falseでの記述 -->
 <watch>false</watch>
<opg_tp>false</opg_tp>
 <!-- 復活可能回数 -->
<rejailcount>10</rejailcount>
<!-- 特殊ブロック 半角数字で設定 0不運/1盲目/2発行/3加速 -->
<spblock>0</spblock> 
<!-- 時間帯の初期値  半角英数字で設定 0/朝,1/昼,2/夜,  
  指定以外の数値や未設定の場合は0になります -->
 <timezone>1</timezone>
 <!-- フィールドの初期値  半角英数字で設定 
 0/平穏,1/温暖,2/寒冷,3/灼熱,4/極寒,5/絶望,6/希望,7/暴風,8/天雷,9/感染  
  指定以外の数値や未設定の場合は0になります -->
 <field>0</field>
<desc>郊外にあるショッピングモール,ご来店お待ちしております,§c推奨ハンター数2人</desc> 
<!-- ランドマークの設定 -->
<landmarks>
  <!-- ID:他のランドマークのIDと重複しないよう注意
       アイコン:以下のURL参照 https://helpch.at/docs/1.16.1/org/bukkit/Material.html 
       指定したアイコンがGUIに表示されます
       loc: X,Y,Z の座標を記述
       運営はテレポートできるため埋まらない地点を、また距離案内も行うので適切な位置を設定すること,
※案内時、目的地から半径5マス以内に入るとアラートが表示
       あくまでランドマークであるため抽象的なものやゲームを有利に進行させる為と思われる設定は認めない(商人は可)
       -->
    <landmark id = "商人" icon = "chest" loc="164.3,30.0,-100.51"/> 
    <landmark id = "ペットショップ" icon = "leather_horse_armor" loc="205.68,22.0,-141.18"/>
    <landmark id = "ゲームセンター" icon = "target" loc="83.19,30.0,-124.71"/>
    <landmark id = "逃走書店" icon = "knowledge_book" loc="183.32,22.0,-100.52"/>
    <landmark id = "RFMストア_舞倉ショッピングモール店" icon = "chest" loc="153.68,30.0,-103.84"/> 
    <landmark id = "フードコート" icon = "cooked_beef" loc="150.82,30.0,-177.09"/>
    <landmark id = "ラーメン店" icon = "rabbit_stew" loc="189.62,22.0,-201.2"/>
    <landmark id = "ファミレス" icon = "pumpkin_pie" loc="159.45,22.0,-202.58"/>
    <landmark id = "食料品店" icon = "potato" loc="57.45,22.0,-100.99"/> 
    <landmark id = "寝具店" icon = "red_bed" loc="52.35,22.0,-214.85"/>
    <landmark id = "コンソールルーム" icon = "command_block" loc="164.11,30.0,-84.47"/>
</landmarks>
<!-- 自動でナイトビジョンを設定するか-->
<auto_nightvision active="true"/>
<!-- mapはマップの大きさをS,M,Lで表記します。
      可変式である場合、最大状態の大きさを記載してください。
      map_descにはmapの大きさに関する補足があれば記載してください。
 　　 hunterには推奨人数を数値で記載します。
 　　 hunter_descにはhunter推奨人数に関する補足があれば記載してください。
 　　 desc系統は「,」で改行できます。
 　　 desc系統は必須では有りません。必要な情報のみ記載してください。-->
 <size map="M" hunter="2"/>
</map>
