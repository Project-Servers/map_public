        <type>POLAR_BEAR</type>
        <type>VILLAGER</type>
        <type>SALMON</type>
    </mob_spawn>

    <location>
        <hunter>-57.5,59,-94.5,-90,0</hunter>
        <player>-41.5,59,-94.5,90,0</player>
        <opg>-41.5,59,-94.5,90,0</opg>
