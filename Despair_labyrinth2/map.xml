<?xml version="1.0" encoding="utf-8" standalone="no"?>
<map>
    <!-- マップ名 ※必須※ -->
    <name>絶望迷宮 -Second Season-</name>

    <!-- マップバージョン ※必須※ -->
    <version>1.0.0</version>

    <desc>ただの迷路。,他ミッションもいけんこともない。</desc>
    <size map="S"  hunter="2～"/>

    <!-- サブタイトルを設定します -->
