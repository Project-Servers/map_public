<?xml version="1.0" encoding="utf-8" standalone="no"?>
<map>
  <!-- マップ名 ※必須※ -->
  <name>ゴロツキタウン</name>
  <!-- マップバージョン ※必須※ -->
  <version>2.3.1</version>
  <!-- 製作者  ※必須※　複数人指定可能 -->
  <authors>
    <author uuid="1de19f0e-b5d2-4415-a478-961c71bfd04e">Syuryu0919</author>
  </authors>
  <!-- ゲーム時間 半角数字で設定/分単位/
   未設定の場合25分に設定されます -->
  <time>35</time>
  <!-- サブタイトルを設定します -->
  <subtitle>♪♪ゴロツキタウンへようこそ！♪♪</subtitle>
  <!-- ゲーム開始時/途中参加時に配られる
アイテムの個数 半角数字で設定 未設定の場合5個に設定されます-->
  <start>
    <egg>13</egg>
    <bone>13</bone>
    <feather>13</feather>
  </start>
  <!-- 復活時に配られるアイテムの個数 
 半角数字で設定 未設定の場合5個に設定されます-->
  <rejail>
    <egg>13</egg>
    <bone>13</bone>
    <feather>13</feather>
  </rejail>
  <!-- 各種地点 ※必須※-->
  <location>
    <player>1644.5,81.0,66.5,0.0,0.0</player>
    <clear>1664.5,39.0,71.5,180.0,0.0</clear>
    <hunter>1693.5,82.0,27.0,0.0,0.0</hunter>
    <jail>1588.5,39.0,69.5,180.0,0.0</jail>
    <rejail1>1644.5,4.0,50.0,0.0,0.0</rejail1>
    <rejail2>1685.5,95.0,152.5,0.0,0.0</rejail2>
    <door>1693.5,82.5,37.5,0.0,0.0</door>
    <opg>1693.5,81.0,59.0,180.0,0.0</opg>
    <!-- shopは設定しなくても可-->
    <shop>1649.0,81.0,95.5,-180.0,0.0</shop>
  </location>
  <!-- NPCの出現位置を設定します。
  ※注意:1※一点に集中して設定せず位置をある程度バラしてください。
       復活地点や初期スポーンなどからも一定の距離をあけてください。
  ※注意:2※プレイヤーが触れられる位置を設定してください。NPCですので空中などには設定しないでください。
  ※注意:3※最低5地点を設定してください。(ver10.9.0時点)
       今後のアップデートにて必要最低地点数は変更される場合がありますが、現時点では未定です。多い分には問題ありません。 -->
  <npcs>
    <npc loc="1636.5,78.0,42.5,-90,0" />
    <npc loc="1633.5,88.0,90.5,-90,0" />
    <npc loc="1586.0,81.0,87.5,180,0" />
    <npc loc="1702.0,87.1875,88.7,0,0" />
    <npc loc="1669.0,95,164.5,180,0" />
    <npc loc="1681.5,99,251.5,180,0" />
    <npc loc="1638.5,96.0625,246.5,90,0" />
    <npc loc="1728.3,96,241.5,90,0" />
    <npc loc="1715.3,96.1875,305.5,90,0" />
    <npc loc="1717.5,106,311.5,45,0" />
    <npc loc="1502.5,54,62.5,-90,0" />
    <npc loc="1645.5,61.0,89.5,-135,0" />
    <npc loc="1541.5,41,69.0,-90,0" />
    <npc loc="1630.5,37,97.5,180,0" />
    <npc loc="1644.5,5,89.7,180,0" />
  </npcs>
  <!-- ランドマークの設定 -->
  <landmarks>
    <!-- ID:他のランドマークのIDと重複しないよう注意
       アイコン:以下のURL参照 https://helpch.at/docs/1.16.1/org/bukkit/Material.html 
       指定したアイコンがGUIに表示されます
       loc: X,Y,Z の座標を記述
       運営はテレポートできるため埋まらない地点を、また距離案内も行うので適切な位置を設定すること,
※案内時、目的地から半径5マス以内に入るとアラートが表示
       あくまでランドマークであるため抽象的なものやゲームを有利に進行させる為と思われる設定は認めない(商人は可)
       -->
    <landmark id="演出制御盤" icon="command_block" loc="1650.5,78.0,10.5" />
    <landmark id="ゴロツキタウン中央(初期スポ付近)" icon="red_sandstone" loc="1644.5,83.0,74.5" />
    <landmark id="地上ＯＰＧ" icon="iron_door" loc="1693.5,81.07,59.5" />
    <landmark id="ウーロン街行きエレベーター" icon="green_concrete" loc="1681.5,81.0,106.5" />
    <landmark id="リッチリッチエクスプレス乗車口" icon="minecart" loc="1714.5,85.0,109.5" />
    <landmark id="Shop入口" icon="crafting_table" loc="1633.5,61.0,76.5" />
    <landmark id="地下OPG" icon="iron_trapdoor" loc="1640.5,54.0,49.5" />
    <landmark id="1000年のトビラ" icon="crimson_door" loc="1644.5,4.0,57.5" />
    <landmark id="地下100階ダンジョン入口" icon="stone_bricks" loc="1688.5,8.0,57.5" />
    <landmark id="牢獄前" icon="iron_bars" loc="1588.5,37.0,64.0" />
    <landmark id="闘技場リング" icon="iron_sword" loc="1685.5,99.0,247.5" />
    <landmark id="闘技場倉庫" icon="purple_shulker_box" loc="1685.5,96.0,300.5" />
    <landmark id="リッチリッチエクスプレス運転席" icon="grindstone" loc="1675.5,84.0,137.5" />
  </landmarks>
  <regions>
    <!-- RegionTypeの設定 -->
    <!-- 個別RegionがactiveでもRegionTypeがactiveでなければregionは動作しない-->
    <!-- RegionType:hunterzoneの初期値をactiveにするかどうか -->
    <hunterzone active="true" />
    <!-- ※RegionType:opgのactive化はOPG開始時に自動で行うためxmlでは設定できません -->
    <!-- 個別Regionの設定 -->
    <!-- typeはhunterzone/opg から選択 , 
        hunterzone→ハンターゾーン
        opg→OPGエリア
        activeはtrue/false  trueで稼働 ※RegionTypeがactive(true)である必要がある,
        idは任意の値で可 他のregionのidと重複しないように
        min,maxは X,Y,Z座標を記入する 
        ※記入漏れがある場合regionは作成されない※ -->
    <region type="opg" active="false" id="ゴロツキ地下１F" min="1638,52,36" max="1642,57,50" />
    <region type="opg" active="false" id="1000年のトビラ" min="1647,3,51" max="1641,8,28" />
    <region type="opg" active="true" id="ゴロツキ西エリア" min="1697,86,60" max="1689,80,38" />
  </regions>
  <!-- ゲーム自動終了  true/falseでの記述 -->
  <auto_end>true</auto_end>
  <!-- 自動復活の初期値  true/falseでの記述 -->
  <auto_rejail>false</auto_rejail>
  <!-- 観戦機能の初期値  true/falseでの記述 -->
  <watch>false</watch>
  <!-- 天候の初期値  半角英数字で設定 0でnormal 1でhot 2でcold  
  指定以外の数値は強制的にnormalになります -->
  <climate>0</climate>
  <!-- スポーンを許可する友好モブ 複数指定可能-->
  <mob_spawn>
    <type>POLAR_BEAR</type>
  </mob_spawn>
  <!-- 時間帯の初期値  半角英数字で設定 0/朝,1/昼,2/夜,  
  指定以外の数値や未設定の場合は0になります -->
  <timezone>1</timezone>
  <!-- フィールドの初期値  半角英数字で設定 
 0/平穏,1/温暖,2/寒冷,3/灼熱,4/極寒,5/絶望,6/希望,7/暴風,8/天雷,9/感染  
  指定以外の数値や未設定の場合は0になります -->
  <field>0</field>
  <!-- OPG終了時のTP  true/falseでの記述 
   trueでテレポートを行う-->
  <opg_tp>false</opg_tp>
  <!-- 復活可能回数 -->
  <rejailcount>10</rejailcount>
  <!-- 特殊ブロック 半角数字で設定 0不運/1盲目/2発行/3加速 -->
  <spblock>2</spblock>
  <!-- mapはマップの大きさをS,M,Lで表記します。
      可変式である場合、最大状態の大きさを記載してください。
      map_descにはmapの大きさに関する補足があれば記載してください。
 　　 hunterには推奨人数を数値で記載します。例： 2
 　　 もし幅を持たせたいのならば次のように記載します。 例: 2-3
 　　 上記以外の記載方法では認識されません。
 　　 hunter_descにはhunter推奨人数に関する補足があれば記載してください。
 　　 desc系統は「,」で改行できます。
 　　 desc系統は必須では有りません。必要な情報のみ記載してください。-->
  <size map="L" hunter="4" />
  <!--  記述例2 <size map="M" hunter="3"/> -->
  <desc>§e出典：ペーパーマリオＲＰＧ,§r§2リメイクに合わせて、地下からウーロン街に直接行けるよ！,§d広さは東京ドームおよそ０．７４個分,§l§b現在のバージョン2.3.1§r</desc>
</map>