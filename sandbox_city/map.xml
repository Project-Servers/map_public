    <landmark icon="BRICKS" id="未来----&gt;西洋" loc="231.0500375403197,77.0,115.0302857060861"/>
    <landmark icon="GRASS_BLOCK" id="縄文----&gt;未来" loc="187.29668986672067,152.0,237.019981455908"/>
    <landmark icon="GRASS_BLOCK" id="未来----&gt;縄文" loc="187.29668986672067,77.0,237.019981455908"/>
    <landmark icon="SANDSTONE" id="江戸----&gt;未来" loc="150.66543701757962,152.0,181.88590915643607"/>
    <landmark icon="SANDSTONE" id="未来----&gt;江戸" loc="150.65416942074964,77.0,181.8871774380084"/>
    </landmarks>
<!-- mapはマップの大きさをS,M,Lで表記します。
      可変式である場合、最大状態の大きさを記載してください。
      map_descにはmapの大きさに関する補足があれば記載してください。
 　　 hunterには推奨人数を数値で記載します。
 　　 hunter_descにはhunter推奨人数に関する補足があれば記載してください。
 　　 desc系統は「,」で改行できます。
 　　 desc系統は必須では有りません。必要な情報のみ記載してください。-->
 <size hunter="3" map="M"/>
</map>
